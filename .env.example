# GEMINI_API_KEY: Required for Google Gemini models.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional for OpenAI ChatGPT models (gpt-4o, gpt-4o-mini).
OPENAI_API_KEY=""

# ANTHROPIC_API_KEY: Optional for Anthropic Claude models (claude-3-5-sonnet, claude-3-haiku).
ANTHROPIC_API_KEY=""

# MOONSHOT_API_KEY: Optional for Moonshot AI Kimi models (moonshot-v1-8k, moonshot-v1-32k).
MOONSHOT_API_KEY=""

# NIVA_AI_DEFAULT_PROVIDER: Default preferred provider ("auto", "gemini", "openai", "claude", "kimi").
NIVA_AI_DEFAULT_PROVIDER="auto"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

